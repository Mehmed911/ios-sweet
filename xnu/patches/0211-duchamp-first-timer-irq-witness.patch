diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 391a4ac..89d17e5 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -28,6 +28,7 @@ extern unsigned char iso_font[256 * 16];
 /* Initialized data must remain writable until disable, including panics. */
 static unsigned int early_row, early_col;
 static unsigned int early_started, early_disabled, early_panicking;
+static unsigned int early_timer_irq_seen;
 
 static void
 sweet_early_clear_row(void)
@@ -114,6 +115,29 @@ sweet_early_mark(unsigned int stage, const char *label)
 	sweet_early_putc('\n');
 }
 
+void
+sweet_early_timer_irq_witness(void)
+{
+	/*
+	 * IRQ context cannot safely re-enter the text console.  Paint a dedicated
+	 * bottom-right witness once, without touching its row/column state.  The
+	 * caller invokes this only after rtclock_intr() returned successfully.
+	 */
+	if (early_disabled ||
+	    __atomic_exchange_n(&early_timer_irq_seen, 1u, __ATOMIC_RELAXED) != 0) {
+		return;
+	}
+	const unsigned int marker_width = 96u;
+	const unsigned int start = EARLY_WIDTH > marker_width ?
+	    EARLY_WIDTH - marker_width : 0;
+	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
+		for (unsigned int x = start; x < EARLY_WIDTH; x++) {
+			EARLY_FB[y * EARLY_STRIDE + x] = 0xff00ffffu;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
