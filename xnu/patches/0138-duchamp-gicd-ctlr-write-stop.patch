--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -222,24 +222,26 @@ pe_init_fiq()
 	// ABL leaves only ARE_NS set; Linux writes ARE_NS | EnableGrp1A | EnableGrp1
 	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
 #if defined(DUCHAMP)
-	/* Twenty-second gate: prepare enable bits locally; GICD writes untouched. */
+	/* Twenty-third gate: write GICD_CTLR once; stop before the RWP read. */
 	static const char gicd_hex[] = "0123456789abcdef";
-	char gicd_label[] = "DUCHAMP GICD_LOCAL=0x00000000";
+	char gicd_label[] = "DUCHAMP GICD_WRITE=0x00000000";
 	gicd_ctlr |= GICD_CTLR_ARE_NS | GICD_CTLR_ENABLEGRP1A | GICD_CTLR_ENABLEGRP1;
 	for (unsigned int i = 0; i < 8; i++) {
 		gicd_label[21 + i] = gicd_hex[(gicd_ctlr >> ((7 - i) * 4)) & 0xf];
 	}
-	kprintf("DUCHAMP GICD_CTLR LOCAL 0x%x\n", gicd_ctlr);
-	sweet_early_mark(46, gicd_label);
-	__asm__ volatile("dsb sy; isb" ::: "memory");
-	for (;;) {
-		__asm__ volatile("wfe" ::: "memory");
-	}
 #endif
 #if !defined(DUCHAMP)
 	gicd_ctlr |= GICD_CTLR_ARE_NS | GICD_CTLR_ENABLEGRP1A | GICD_CTLR_ENABLEGRP1;
 #endif
 	gicd_write32(GICD_CTLR, gicd_ctlr);
+#if defined(DUCHAMP)
+	kprintf("DUCHAMP GICD_CTLR WRITE 0x%x\n", gicd_ctlr);
+	sweet_early_mark(47, gicd_label);
+	__asm__ volatile("dsb sy; isb" ::: "memory");
+	for (;;) {
+		__asm__ volatile("wfe" ::: "memory");
+	}
+#endif
 	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
 		;
 	}
