--- /dev/null
+++ b/osfmk/arm64/sweet_bootstrap.h
@@ -0,0 +1,30 @@
+/* Bootstrap framebuffer geometry, shared by C and assembly.
+ * DUCHAMP is an experimental console-only variant of the SWEET configuration.
+ * This header does not port interrupts, memory allocation, storage, or input.
+ */
+#ifndef SWEET_BOOTSTRAP_GEOMETRY_H
+#define SWEET_BOOTSTRAP_GEOMETRY_H
+#if defined(DUCHAMP) && !defined(SWEET)
+#error DUCHAMP bootstrap currently requires the SWEET source configuration
+#endif
+#if defined(DUCHAMP)
+#define SWEET_BOOT_FB_BASE 0xfcc2f000
+#define SWEET_BOOT_FB_WIDTH 1220
+#define SWEET_BOOT_FB_HEIGHT 2712
+#define SWEET_BOOT_FB_STRIDE 4992
+#else
+#define SWEET_BOOT_FB_BASE 0x9c000000
+#define SWEET_BOOT_FB_WIDTH 1080
+#define SWEET_BOOT_FB_HEIGHT 2400
+#define SWEET_BOOT_FB_STRIDE 4320
+#endif
+#define SWEET_BOOT_FB_BLOCK_SIZE 0x02000000
+#define SWEET_BOOT_FB_BLOCK_BASE (SWEET_BOOT_FB_BASE & ~(SWEET_BOOT_FB_BLOCK_SIZE - 1))
+#define SWEET_BOOT_FB_OFFSET (SWEET_BOOT_FB_BASE - SWEET_BOOT_FB_BLOCK_BASE)
+#if SWEET_BOOT_FB_OFFSET + SWEET_BOOT_FB_HEIGHT * SWEET_BOOT_FB_STRIDE > SWEET_BOOT_FB_BLOCK_SIZE
+#error Bootstrap framebuffer crosses the single mapped L2 block
+#endif
+#if SWEET_BOOT_FB_STRIDE < SWEET_BOOT_FB_WIDTH * 4 || SWEET_BOOT_FB_STRIDE % 4
+#error Invalid bootstrap framebuffer stride
+#endif
+#endif
