 	arm_vm_init(xmaxmem, args);
 	sweet_early_mark(15, "arm_vm_init returned");
+#if defined(DUCHAMP)
+	/* First MT6897 experiment: stop before serial/IRQ/IOKit/BSD startup. */
+	sweet_early_mark(15, "DUCHAMP XNU MEMORY READY");
+	__asm__ volatile("dsb sy; isb" ::: "memory");
+	for (;;) {
+		__asm__ volatile("wfe" ::: "memory");
+	}
+#endif
+
 
