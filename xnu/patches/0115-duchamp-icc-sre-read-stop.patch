--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -190,16 +190,7 @@ pe_init_fiq()
 	for (unsigned int i = 4; i < 32; i += 4) {
 		gicr_write32(GICR_IPRIORITYR0 + i, 0xA0A0A0A0);
 	}
 	gicr_write32(GICR_ISENABLER0, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
-#if defined(DUCHAMP)
-	/* Eleventh gate: the enable write completed; no CPU-interface access. */
-	kprintf("DUCHAMP GICR ENABLE WRITE READY\n");
-	sweet_early_mark(35, "DUCHAMP GICR ENABLE WRITE READY");
-	__asm__ volatile("dsb sy; isb" ::: "memory");
-	for (;;) {
-		__asm__ volatile("wfe" ::: "memory");
-	}
-#endif
 #else
 	// Configure timers and legacy FIQ to be group 0
 	gicr_write32(GICR_IGROUPR0, 0x81FFFFFF);
@@ -211,5 +202,14 @@ pe_init_fiq()
 
 	// Enable system register access
 	uint64_t icc_sre = __builtin_arm_rsr64("ICC_SRE_EL1");
+#if defined(DUCHAMP)
+	/* Twelfth gate: ICC_SRE_EL1 was read, but has not been modified or written. */
+	kprintf("DUCHAMP ICC_SRE_EL1 READ 0x%llx\n", (unsigned long long)icc_sre);
+	sweet_early_mark(36, "DUCHAMP ICC_SRE_EL1 READ READY");
+	__asm__ volatile("dsb sy; isb" ::: "memory");
+	for (;;) {
+		__asm__ volatile("wfe" ::: "memory");
+	}
+#endif
 	icc_sre |= ICC_SRE_SRE;
 	__builtin_arm_wsr64("ICC_SRE_EL1", icc_sre);
